# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/rdmarket?sslmode=disable

# External Exchange Rate Feed Provider
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1
EXCHANGE_RATE_API_KEY=

# Application Environment
APP_ENV=production
PORT=8080

# Rule-Based Market Condition Thresholds
SHORT_TERM_THRESHOLD=0.002
TREND_30D_THRESHOLD=0.005
VOLATILITY_LOW_LIMIT=0.004
VOLATILITY_HIGH_LIMIT=0.010
