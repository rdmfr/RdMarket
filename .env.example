# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rdmarket?sslmode=disable

# External Exchange Rate Feed Provider (frankfurter | mock | csv)
EXCHANGE_RATE_PROVIDER=mock
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1
EXCHANGE_RATE_API_KEY=

# Application Environment (development | test | production)
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Provider synchronization cadence and maximum history response size
INGESTION_INTERVAL_MINUTES=15
HISTORY_POINT_LIMIT=1500

# Auth Configuration
ADMIN_USERNAME=admin
# bcrypt hash for example password (admin123)
ADMIN_PASSWORD_HASH=$2a$10$l7ofOGwF/s0KSIAgKdRz1.1FDfS8/h.LLopGGuL10YugLiZl69qPa
SESSION_SECRET=insecure-dev-session-secret-min-32-chars-long
AUTH_REQUIRE_READ=false

# Rule-Based Market Condition Thresholds
SHORT_TERM_THRESHOLD=0.002
TREND_30D_THRESHOLD=0.005
VOLATILITY_LOW_LIMIT=0.004
VOLATILITY_HIGH_LIMIT=0.010

# Internal forecasting service (development only; replace credentials outside local development)
FORECAST_SERVICE_URL=http://forecasting:8000
FORECAST_DB_USER=rdm_forecast
FORECAST_DB_PASSWORD=rdmarket-dev-forecast-password-change-me
FORECAST_DB_HOST=postgres
FORECAST_DB_PORT=5432
FORECAST_DB_NAME=rdmarket
FORECAST_MAX_CONCURRENT_JOBS=2
FORECAST_JOB_TIMEOUT_SECONDS=900
FORECAST_SCHEDULER_ENABLED=false
FORECAST_DEFAULT_INTERVALS=0.8,0.95
FORECAST_INTERNAL_TOKEN=rdmarket-dev-forecast-token-change-me-32
FORECAST_INSTALL_ML=true
FORECAST_ENABLE_ML=true
FORECAST_RANDOM_SEED=42
FORECAST_LSTM_MAX_EPOCHS=40
FORECAST_LSTM_WINDOW=20
FORECAST_LSTM_LAYERS=1
FORECAST_LSTM_UNITS=32
FORECAST_LSTM_DROPOUT=0.1
FORECAST_LSTM_LEARNING_RATE=0.001
FORECAST_LSTM_BATCH_SIZE=32
FORECAST_LSTM_REFIT_EVERY_N_FOLDS=5
FORECAST_LSTM_MAX_FOLDS=20
